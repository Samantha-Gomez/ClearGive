NODE_ENV=development
PORT=5000
MONGO_URI=replace_with_your_mongodb_connection_string
MONGO_DNS_SERVER=1.1.1.1
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=1h
SESSION_MAX_AGE_MS=3600000
ADMIN_EMAIL=admin@example.com
ALLOW_LOCAL_RATE_LIMIT_TESTING=false


# Choose one provider: brevo, resend, or smtp.
# If omitted, ClearGive selects Brevo, then Resend, then SMTP based on configured keys.
EMAIL_PROVIDER=smtp

# Gmail or another SMTP provider. Common Gmail ports: 587 (TLS) or 465 (secure).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_DEV_LOG=false

# Resend HTTPS API. EMAIL_FROM must use a sender/domain accepted by Resend.
RESEND_API_KEY=

# Brevo HTTPS transactional-email API. Verify BREVO_FROM_EMAIL in Brevo first.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ClearGive
